prefix_rule(
    pattern = [["npx", "bunx", "pnpx"]],
    decision = "forbidden",
    justification = "No ejecutes paquetes sin instalarlos con Socket.",
    match = ["npx x", "bunx x", "pnpx x"],
    not_match = ["sfw pnpm add x"],
)

prefix_rule(
    pattern = ["npm", ["install", "i", "ci", "add", "update"]],
    decision = "forbidden",
    justification = "Instala con Socket: sfw pnpm add <paquete>, o sfw npm install si el proyecto aún usa npm.",
    match = ["npm install x", "npm i x", "npm ci"],
    not_match = ["sfw npm install", "npm run dev", "npm test"],
)

prefix_rule(
    pattern = [["yarn", "bun"], ["add", "install"]],
    decision = "forbidden",
    justification = "Instala con Socket: sfw pnpm add <paquete>.",
    match = ["yarn add x", "bun add x", "bun install"],
    not_match = ["bun run dev"],
)

prefix_rule(
    pattern = ["pnpm", ["add", "dlx", "install", "i", "update", "up"]],
    decision = "forbidden",
    justification = "Instala siempre a través de Socket: sfw pnpm add <paquete>, sfw pnpm install.",
    match = ["pnpm add x", "pnpm install", "pnpm dlx x", "pnpm up x"],
    not_match = ["sfw pnpm add x", "sfw pnpm install", "pnpm test"],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--delete"]],
    decision = "forbidden",
    justification = "Nunca fuerces un push ni borres una rama remota.",
    match = ["git push --force origin main", "git push -f origin main", "git push --delete origin main"],
    not_match = ["git push origin feature"],
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr"], ["/", "/*", "~", "~/*", "$HOME", "$HOME/*", "..", "../*"]],
    decision = "forbidden",
    justification = "Nunca borres la raíz, tu carpeta personal ni la carpeta superior.",
    match = ["rm -rf /", "rm -rf ~", "rm -fr .."],
    not_match = ["rm -rf ./dist"],
)
